{
  "rules": {
    ".read": true,
    ".write": false,
    "tournaments": {
      "$tournamentId": {
        ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'admin'"
      }
    },
    "teams": {
      "$tournamentId": {
        ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'admin'"
      }
    },
    "fixtures": {
      "$tournamentId": {
        ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'admin'"
      }
    },
    "scores": {
      "$tournamentId": {
        "$matchId": {
          ".write": "auth != null && (root.child('roles').child(auth.uid).val() === 'admin' || root.child('roles').child(auth.uid).val() === 'scorer')"
        }
      }
    },
    "roles": {
      ".write": false
    }
  }
}
